{
  "name": "@soksak/soksak-kit-plugin-terminal",
  "version": "0.0.113",
  "private": false,
  "engines": {
    "node": "26.7.0"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "error"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-ai/soksak-kit-plugin-terminal.git"
  },
  "type": "module",
  "files": [
    "dist",
    "kit.json",
    "src",
    "!src/**/*.test.ts",
    "LICENSE",
    "README*"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "pnpm build && node --test scripts/*.node.mjs && vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@soksak/soksak-contract-plugin-terminal": "0.0.22"
  },
  "devDependencies": {
    "@soksak/soksak-contract-plugin-terminal": "https://github.com/soksak-ai/soksak-contract-plugin-terminal/releases/download/v0.0.22/soksak-contract-plugin-terminal-0.0.22-any.tgz",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
